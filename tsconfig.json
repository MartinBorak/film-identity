{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src", "*.ts", "*.mts", "*.mjs"],
  "exclude": ["node_modules", "dist"]
}
